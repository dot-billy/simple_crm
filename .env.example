POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_secret_change_me
POSTGRES_DB=crm
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Gmail Integration (Google Workspace)
# 1. Create a service account in Google Cloud Console
# 2. Enable Gmail API
# 3. Set up domain-wide delegation in Google Workspace Admin
# 4. Download the service account JSON key and place it in ./backend/credentials/
GOOGLE_SERVICE_ACCOUNT_FILE=/app/credentials/service-account.json
GOOGLE_DELEGATED_USER=admin@yourcompany.com
GMAIL_SYNC_INTERVAL_SECONDS=300
APP_BASE_URL=http://localhost:8000
SLACK_WEBHOOK_URL=
CRM_FRONTEND_BASE_URL=http://localhost:3000
